{
  "version": "2025-11-01",
  "name": "insufferable",
  "description": "An app's tokens: insufferable's own, then the app's, which win. Its palette, fonts and the roles that name its brand are generated by `insufferable theme` from theme.config.json; the roles are partial files after the system's theme files.",
  "$extensions": { "dev.insufferable": { "prefix": "quince" } },
  "sets": {
    "base": {
      "sources": [
        { "$ref": "../../tokens/insufferable.resolver.json#/sets/base" },
        { "$ref": "theme/palette.tokens.json" },
        { "$ref": "theme/fonts.tokens.json" },
        { "$ref": "shape.tokens.json" }
      ]
    }
  },
  "resolutionOrder": [
    { "$ref": "#/sets/base" },
    { "$ref": "#/modifiers/theme" }
  ],
  "modifiers": {
    "theme": {
      "description": "The page's colours, chosen by the system's colour-scheme preference. Light is the default.",
      "default": "light",
      "contexts": {
        "light": [
          { "$ref": "../../tokens/theme.light.tokens.json" },
          { "$ref": "theme/light.tokens.json" }
        ],
        "dark": [
          { "$ref": "../../tokens/theme.dark.tokens.json" },
          { "$ref": "theme/dark.tokens.json" }
        ]
      },
      "$extensions": {
        "com.toghen": { "css": { "atRule": "@media (prefers-color-scheme: {context})" } }
      }
    }
  }
}
