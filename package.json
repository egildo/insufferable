{
  "name": "insufferable",
  "version": "0.0.0",
  "private": true,
  "description": "A lean design system of UI elements: W3C tokens resolved by Toghen, ARIA states as selectors, Invoker commands out",
  "type": "module",
  "exports": {
    "./resolver.json": "./tokens/insufferable.resolver.json",
    "./tokens/*": "./tokens/*",
    "./styles.css": "./dist/insufferable.css",
    "./commands.js": "./dist/commands.js",
    "./tabs.js": "./dist/components/tabs.js",
    "./icon.js": "./dist/components/icon.js",
    "./menu.js": "./dist/components/menu.js",
    "./toolbar.js": "./dist/components/toolbar.js",
    "./tree.js": "./dist/components/tree.js",
    "./splitter.js": "./dist/components/splitter.js",
    "./shell.js": "./dist/components/shell.js"
  },
  "files": [
    "tokens/",
    "dist/",
    "src/",
    "icons/",
    "scripts/build.mjs",
    "scripts/icons.mjs",
    "scripts/cli.mjs",
    "scripts/theme.mjs"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "palette": "gosfuig tokens/palette.config.json --no-dashboard -o .palette && mv .palette/tokens.json tokens/palette.tokens.json && rmdir .palette",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "figcraft": "node scripts/figcraft.mjs",
    "prepack": "pnpm build"
  },
  "license": "MIT",
  "author": "Egildo Tagliareni <egildo@tagliareni.it>",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@toghen/figma": "^0.1.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@csstools/postcss-mixins": "^1.1.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@tabler/icons": "^3.50.0",
    "@tabler/icons-webfont": "^3.49.0",
    "@toghen/lib": "^0.1.1",
    "@toghen/postcss": "^0.1.1",
    "gosfuig": "^0.2.0",
    "opentype.js": "^2.0.0",
    "paper": "^0.17.0",
    "paperjs-offset": "^2.2.2",
    "postcss": "^8.5.32",
    "ttf2woff2": "^8.0.1"
  },
  "bin": {
    "insufferable": "./scripts/cli.mjs"
  }
}
