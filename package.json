{
  "name": "insufferable",
  "version": "0.1.0",
  "description": "A lean design system of UI elements: W3C tokens resolved by Toghen, ARIA states as selectors, Invoker commands out",
  "type": "module",
  "exports": {
    "./styles.css": "./dist/insufferable.css",
    "./resolver.json": "./tokens/insufferable.resolver.json",
    "./tokens/*": "./tokens/*",
    "./config.schema.json": "./contracts/config.schema.json",
    "./color.js": {
      "types": "./dist/color.d.ts",
      "default": "./dist/color.js"
    },
    "./commands.js": {
      "types": "./dist/commands.d.ts",
      "default": "./dist/commands.js"
    },
    "./dates.js": {
      "types": "./dist/dates.d.ts",
      "default": "./dist/dates.js"
    },
    "./elements.js": {
      "types": "./dist/elements.d.ts",
      "default": "./dist/elements.js"
    },
    "./icons.js": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./keys.js": {
      "types": "./dist/keys.d.ts",
      "default": "./dist/keys.js"
    },
    "./components/calendar.js": {
      "types": "./dist/components/calendar.d.ts",
      "default": "./dist/components/calendar.js"
    },
    "./components/combobox.js": {
      "types": "./dist/components/combobox.d.ts",
      "default": "./dist/components/combobox.js"
    },
    "./components/icon.js": {
      "types": "./dist/components/icon.d.ts",
      "default": "./dist/components/icon.js"
    },
    "./components/menu.js": {
      "types": "./dist/components/menu.d.ts",
      "default": "./dist/components/menu.js"
    },
    "./components/shell.js": {
      "types": "./dist/components/shell.d.ts",
      "default": "./dist/components/shell.js"
    },
    "./components/splitter.js": {
      "types": "./dist/components/splitter.d.ts",
      "default": "./dist/components/splitter.js"
    },
    "./components/table.js": {
      "types": "./dist/components/table.d.ts",
      "default": "./dist/components/table.js"
    },
    "./components/tabs.js": {
      "types": "./dist/components/tabs.d.ts",
      "default": "./dist/components/tabs.js"
    },
    "./components/toolbar.js": {
      "types": "./dist/components/toolbar.d.ts",
      "default": "./dist/components/toolbar.js"
    },
    "./components/tooltip.js": {
      "types": "./dist/components/tooltip.d.ts",
      "default": "./dist/components/tooltip.js"
    },
    "./components/tree.js": {
      "types": "./dist/components/tree.d.ts",
      "default": "./dist/components/tree.js"
    },
    "./icon.js": {
      "types": "./dist/components/icon.d.ts",
      "default": "./dist/components/icon.js"
    },
    "./menu.js": {
      "types": "./dist/components/menu.d.ts",
      "default": "./dist/components/menu.js"
    },
    "./shell.js": {
      "types": "./dist/components/shell.d.ts",
      "default": "./dist/components/shell.js"
    },
    "./splitter.js": {
      "types": "./dist/components/splitter.d.ts",
      "default": "./dist/components/splitter.js"
    },
    "./tabs.js": {
      "types": "./dist/components/tabs.d.ts",
      "default": "./dist/components/tabs.js"
    },
    "./toolbar.js": {
      "types": "./dist/components/toolbar.d.ts",
      "default": "./dist/components/toolbar.js"
    },
    "./tree.js": {
      "types": "./dist/components/tree.d.ts",
      "default": "./dist/components/tree.js"
    }
  },
  "files": [
    "tokens/",
    "dist/",
    "src/",
    "icons/",
    "contracts/config.schema.json",
    "scripts/build.mjs",
    "scripts/check.mjs",
    "scripts/cli.mjs",
    "scripts/config.mjs",
    "scripts/icons.mjs",
    "scripts/init.mjs",
    "scripts/theme.mjs"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "palette": "gosfuig tokens/palette.config.json --no-dashboard -o .palette && mv .palette/tokens.json tokens/palette.tokens.json && rmdir .palette",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "figcraft": "node scripts/figcraft.mjs",
    "prepack": "rm -rf dist && pnpm build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egildo/insufferable.git"
  },
  "homepage": "https://codeberg.org/egildo/insufferable",
  "bugs": {
    "url": "https://codeberg.org/egildo/insufferable/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Egildo Tagliareni <egildo@tagliareni.it>",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@toghen/figma": "^0.1.16",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@csstools/postcss-mixins": "^1.1.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@tabler/icons": "^3.50.0",
    "@tabler/icons-webfont": "^3.49.0",
    "@toghen/lib": "^0.1.1",
    "@toghen/postcss": "^0.1.1",
    "gosfuig": "^0.2.0",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.32",
    "ttf2woff2": "^8.0.1",
    "unstroke": "^1.0.0"
  },
  "bin": {
    "insufferable": "scripts/cli.mjs"
  }
}
