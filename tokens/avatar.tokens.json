        "$type": "color",
        "$value": "{ins.color.accentDeep}"
      },
      "backgroundColor": {
        "$type": "color",
        "$value": "{ins.color.accentTint}"
      },
      "inlineSize": {
        "$type": "dimension",
        "$value": "{ins.size.control}"
      },
      "blockSize": {
        "$type": "dimension",
        "$value": "{ins.size.control}"
      },
      "borderRadius": {
        "$type": "dimension",
        "$value": "{ins.radius.round}"
      },
      "font": {
        "$type": "typography",
        "$value": "{ins.typography.label}"
      }
    },
    "avatars": {
