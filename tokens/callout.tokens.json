{
  "ins": {
    "callout": {
      "$description": "A note set apart from the text: role=note, or role=alert when it must be announced. A tinted ground and a bar at the start in the accent; class=danger in the danger, class=warn in the warning.",
      "$extensions": {
        "com.toghen": {
          "css": {
            "parts": {
              "variant": {
                "warn": ".warn",
                "danger": ".danger"
              }
            }
          }
        }
      },
      "color": {
        "$type": "color",
        "$value": "{ins.color.text.1}"
      },
      "backgroundColor": {
        "$type": "color",
        "$value": "{ins.color.accentTint}"
      },
      "borderInlineStartColor": {
        "$type": "color",
        "$value": "{ins.color.accent}"
      },
      "borderInlineStartWidth": {
        "$type": "dimension",
        "$value": "{ins.border.2}"
      },
      "paddingBlock": {
        "$type": "dimension",
        "$value": "{ins.space.3}"
      },
      "paddingInline": {
        "$type": "dimension",
        "$value": "{ins.space.3}"
      },
      "danger": {
        "backgroundColor": {
          "$type": "color",
          "$value": "{ins.color.dangerTint}"
        },
        "borderInlineStartColor": {
          "$type": "color",
          "$value": "{ins.color.danger}"
        }
      },
      "warn": {
        "backgroundColor": {
          "$type": "color",
          "$value": "{ins.color.warnTint}"
        },
        "borderInlineStartColor": {
          "$type": "color",
          "$value": "{ins.color.warn}"
        }
      }
    }
  }
}
