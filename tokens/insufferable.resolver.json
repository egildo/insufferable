{
  "version": "2025-11-01",
  "name": "insufferable",
  "description": "insufferable's tokens, one file per concern. The base set holds what no theme changes: the vocabulary, the palette gosfuig writes, the scales, the type, and one file per element, whose states are parts. The theme modifier holds the colour roles, one whole file per context.",
  "sets": {
    "base": {
      "sources": [
        {
          "$ref": "vocabulary.tokens.json"
        },
        {
          "$ref": "palette.tokens.json"
        },
        {
          "$ref": "scales.tokens.json"
        },
        {
          "$ref": "type.tokens.json"
        },
        {
          "$ref": "page.tokens.json"
        },
        {
          "$ref": "link.tokens.json"
        },
        {
          "$ref": "divider.tokens.json"
        },
        {
          "$ref": "table.tokens.json"
        },
        {
          "$ref": "callout.tokens.json"
        },
        {
          "$ref": "tabs.tokens.json"
        },
        {
          "$ref": "disclosure.tokens.json"
        },
        {
          "$ref": "icon.tokens.json"
        },
        {
          "$ref": "button.tokens.json"
        },
        {
          "$ref": "field.tokens.json"
        },
        {
          "$ref": "listbox.tokens.json"
        },
        {
          "$ref": "choice.tokens.json"
        },
        {
          "$ref": "segmented.tokens.json"
        },
        {
          "$ref": "dialog.tokens.json"
        },
        {
          "$ref": "menu.tokens.json"
        },
        {
          "$ref": "toolbar.tokens.json"
        },
        {
          "$ref": "count.tokens.json"
        },
        {
          "$ref": "tag.tokens.json"
        },
        {
          "$ref": "chips.tokens.json"
        },
        {
          "$ref": "choices.tokens.json"
        },
        {
          "$ref": "properties.tokens.json"
        },
        {
          "$ref": "status.tokens.json"
        },
        {
          "$ref": "log.tokens.json"
        },
        {
          "$ref": "tree.tokens.json"
        },
        {
          "$ref": "shell.tokens.json"
        },
        {
          "$ref": "progress.tokens.json"
        },
        {
          "$ref": "spinner.tokens.json"
        },
        {
          "$ref": "meter.tokens.json"
        },
        {
          "$ref": "slider.tokens.json"
        },
        {
          "$ref": "breadcrumb.tokens.json"
        },
        {
          "$ref": "pagination.tokens.json"
        },
        {
          "$ref": "card.tokens.json"
        },
        {
          "$ref": "tooltip.tokens.json"
        },
        {
          "$ref": "toast.tokens.json"
        },
        {
          "$ref": "combobox.tokens.json"
        }
      ]
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/modifiers/theme"
    }
  ],
  "modifiers": {
    "theme": {
      "description": "The page's colours, one per colour scheme. Light is the default. The stylesheet writes each role with light-dark(), so the scheme is the element's color-scheme: the system's by default, or the app's.",
      "default": "light",
      "contexts": {
        "light": [
          {
            "$ref": "theme.light.tokens.json"
          }
        ],
        "dark": [
          {
            "$ref": "theme.dark.tokens.json"
          }
        ]
      },
      "$extensions": {
        "com.toghen": {
          "css": {
            "lightDark": {
              "light": "light",
              "dark": "dark"
            }
          }
        }
      }
    }
  },
  "$extensions": {
    "dev.insufferable": {
      "prefix": "insufferable"
    }
  }
}
