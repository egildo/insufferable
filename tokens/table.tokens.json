{
  "ins": {
    "table": {
      "$description": "A native table: rows divided by a line, the header cells quieter, in the label style, over a stronger line.",
      "cell": {
        "color": {
          "$type": "color",
          "$value": "{ins.color.text.1}"
        },
        "paddingBlock": {
          "$type": "dimension",
          "$value": "{ins.space.2}"
        },
        "paddingInline": {
          "$type": "dimension",
          "$value": "{ins.space.3}"
        },
        "borderBottomColor": {
          "$type": "color",
          "$value": "{ins.color.line}"
        },
        "borderBottomWidth": {
          "$type": "dimension",
          "$value": "{ins.border.1}"
        },
        "font": {
          "$type": "typography",
          "$value": "{ins.typography.body}"
        }
      },
      "header": {
        "color": {
          "$type": "color",
          "$value": "{ins.color.text.2}"
        },
        "borderBottomColor": {
          "$type": "color",
          "$value": "{ins.color.lineStrong}"
        },
        "font": {
          "$type": "typography",
          "$value": "{ins.typography.label}"
        }
      },
      "caption": {
        "color": {
          "$type": "color",
          "$value": "{ins.color.text.2}"
        },
        "paddingBlock": {
          "$type": "dimension",
          "$value": "{ins.space.2}"
        },
        "font": {
          "$type": "typography",
          "$value": "{ins.typography.label}"
        }
      }
    },
    "tableSort": {
      "$description": "A sortable column's header: the title is a button, quiet like the header, with a mark after it that shows the order; the sorted column is in the text colour.",
      "$extensions": {
        "com.toghen": {
          "css": {
            "parts": {
              "sort": {
                "sorted": ":is([aria-sort=ascending] > *, [aria-sort=descending] > *)"
              }
            }
          }
        }
      },
      "color": {
        "$type": "color",
        "$value": "{ins.color.text.2}"
      },
      "backgroundColor": {
        "$type": "color",
        "$value": "{ins.color.clear}"
      },
      "borderRadius": {
        "$type": "dimension",
        "$value": "{ins.radius.1}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{ins.space.1}"
      },
      "outlineColor": {
        "$type": "color",
        "$value": "{ins.color.clear}"
      },
      "outlineWidth": {
        "$type": "dimension",
        "$value": "{ins.border.2}"
      },
      "outlineOffset": {
        "$type": "dimension",
        "$value": "{ins.border.outset}"
      },
      "hover": {
        "color": {
          "$type": "color",
          "$value": "{ins.color.text.1}"
        }
      },
      "focus": {
        "outlineColor": {
          "$type": "color",
          "$value": "{ins.color.accent}"
        }
      },
      "sorted": {
        "color": {
          "$type": "color",
          "$value": "{ins.color.text.1}"
        }
      }
    },
    "tableRow": {
      "$description": "A row of a table that has a checkbox in it: with the box checked, the row takes the accent's tint.",
      "$extensions": {
        "com.toghen": {
          "css": {
            "parts": {
              "selection": {
                "selected": ":has(input:checked)"
              }
            }
          }
        }
      },
      "selected": {
        "backgroundColor": {
          "$type": "color",
          "$value": "{ins.color.accentTint}"
        }
      }
    }
  }
}
