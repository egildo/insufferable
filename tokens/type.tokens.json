{
  "ins": {
    "font": {
      "family": {
        "$type": "fontFamily",
        "sans": {
          "$value": [
            "Archivo",
            "system-ui",
            "sans-serif"
          ],
          "$description": "The house sans: Archivo, variable in weight and width"
        },
        "serif": {
          "$value": [
            "Fraunces",
            "ui-serif",
            "serif"
          ],
          "$description": "The house serif: Fraunces, variable in optical size, weight, softness and wonk"
        },
        "icon": {
          "$value": [
            "tabler-icons"
          ],
          "$description": "The icon font: Tabler Icons, subset by the build to the icons in src/icons.ts"
        },
        "mono": {
          "$value": [
            "ui-monospace",
            "monospace"
          ],
          "$description": "Code: the platform's own monospace, with no font shipped"
        }
      },
      "size": {
        "xs": {
          "$value": {
            "value": 0.75,
            "unit": "rem"
          },
          "$description": "A tag's label"
        },
        "$type": "dimension",
        "sm": {
          "$value": {
            "value": 0.875,
            "unit": "rem"
          }
        },
        "md": {
          "$value": {
            "value": 1,
            "unit": "rem"
          }
        },
        "lg": {
          "$value": {
            "value": 1.25,
            "unit": "rem"
          }
        },
        "xl": {
          "$value": {
            "value": 1.5,
            "unit": "rem"
          }
        },
        "xxl": {
          "$value": {
            "value": 2,
            "unit": "rem"
          }
        },
        "icon": {
          "$value": {
            "value": 1.25,
            "unit": "rem"
          }
        }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": {
          "$value": 400
        },
        "medium": {
          "$value": 500
        },
        "semibold": {
          "$value": 600
        }
      },
      "lineHeight": {
        "$type": "number",
        "tight": {
          "$value": 1
        },
        "snug": {
          "$value": 1.25
        },
        "normal": {
          "$value": 1.5
        }
      },
      "letterSpacing": {
        "$type": "dimension",
        "normal": {
          "$value": {
            "value": 0,
            "unit": "px"
          }
        },
        "wide": {
          "$value": {
            "value": 0.5,
            "unit": "px"
          },
          "$description": "Capitals set small"
        }
      }
    },
    "typography": {
      "$type": "typography",
      "$description": "The text styles. A component reads one whole, as its font.",
      "body": {
        "$value": {
          "fontFamily": "{ins.font.family.sans}",
          "fontSize": "{ins.font.size.md}",
          "fontWeight": "{ins.font.weight.regular}",
          "letterSpacing": "{ins.font.letterSpacing.normal}",
          "lineHeight": "{ins.font.lineHeight.normal}"
        },
        "$description": "Running text"
      },
      "label": {
        "$value": {
          "fontFamily": "{ins.font.family.sans}",
          "fontSize": "{ins.font.size.sm}",
          "fontWeight": "{ins.font.weight.medium}",
          "letterSpacing": "{ins.font.letterSpacing.normal}",
          "lineHeight": "{ins.font.lineHeight.snug}"
        },
        "$description": "The name on a control: a tab, a summary"
      },
      "icon": {
        "$value": {
          "fontFamily": "{ins.font.family.icon}",
          "fontSize": "{ins.font.size.icon}",
          "fontWeight": "{ins.font.weight.regular}",
          "letterSpacing": "{ins.font.letterSpacing.normal}",
          "lineHeight": "{ins.font.lineHeight.tight}"
        },
        "$description": "An icon glyph"
      },
      "display": {
        "$value": {
          "fontFamily": "{ins.font.family.serif}",
          "fontSize": "{ins.font.size.xxl}",
          "fontWeight": "{ins.font.weight.semibold}",
          "letterSpacing": "{ins.font.letterSpacing.normal}",
          "lineHeight": "{ins.font.lineHeight.snug}"
        },
        "$description": "A page title, in the house serif"
      },
      "title": {
        "$value": {
          "fontFamily": "{ins.font.family.serif}",
          "fontSize": "{ins.font.size.xl}",
          "fontWeight": "{ins.font.weight.semibold}",
          "letterSpacing": "{ins.font.letterSpacing.normal}",
          "lineHeight": "{ins.font.lineHeight.snug}"
        },
        "$description": "A section's title, in the house serif"
      },
      "heading": {
        "$value": {
          "fontFamily": "{ins.font.family.sans}",
          "fontSize": "{ins.font.size.lg}",
          "fontWeight": "{ins.font.weight.semibold}",
          "letterSpacing": "{ins.font.letterSpacing.normal}",
          "lineHeight": "{ins.font.lineHeight.snug}"
        },
        "$description": "A heading within a section"
      },
      "small": {
        "$value": {
          "fontFamily": "{ins.font.family.sans}",
          "fontSize": "{ins.font.size.sm}",
          "fontWeight": "{ins.font.weight.regular}",
          "letterSpacing": "{ins.font.letterSpacing.normal}",
          "lineHeight": "{ins.font.lineHeight.normal}"
        },
        "$description": "Small print: a note, a caption"
      },
      "tag": {
        "$value": {
          "fontFamily": "{ins.font.family.sans}",
          "fontSize": "{ins.font.size.xs}",
          "fontWeight": "{ins.font.weight.semibold}",
          "letterSpacing": "{ins.font.letterSpacing.wide}",
          "lineHeight": "{ins.font.lineHeight.normal}"
        },
        "$description": "A tag: a kind or a status, in small capitals"
      },
      "dock": {
        "$value": {
          "fontFamily": "{ins.font.family.sans}",
          "fontSize": "{ins.font.size.xs}",
          "fontWeight": "{ins.font.weight.medium}",
          "letterSpacing": "{ins.font.letterSpacing.normal}",
          "lineHeight": "{ins.font.lineHeight.snug}"
        },
        "$description": "A word under an icon: a dock button's label"
      }
    }
  }
}
